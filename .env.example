# Copy this file to .env and fill in your values. Never commit .env.

# Required for AI plans, the What-if chat and live advisories (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model names (change if Google renames models)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Optional: Google Air Quality API key for finer (500 m) current readings and the official CPCB index
GOOGLE_MAPS_API_KEY=

# Sample winter-smog data for offline demos (set to true only if venue Wi-Fi fails)
DEMO_MODE=false

# Any long random string; used to hash anonymous device ids for Smog Circle pledges
DEVICE_SALT=change-me

# SQLite file for Smog Circle pledges
DB_PATH=data/smogsafe.db

# Contact shown to OpenStreetMap's reverse-geocoding service
CONTACT_EMAIL=you@example.com

AI_REQUESTS_PER_MINUTE=12
